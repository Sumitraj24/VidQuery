# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# FreeLLMAPI Gateway Configuration
# Local development: http://127.0.0.1:31415/v1
# Railway deployment: use your ngrok/tunnel URL, e.g. https://abc123.ngrok-free.app/v1
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
FREELLMAPI_MODEL=auto

# Optional: fastest models first. VidQuery races them for quick answers.
# FREELLMAPI_FAST_MODELS=claude-haiku-4-5,gemini-flash-lite,gemini-3.5-flash-lite,auto
# FREELLMAPI_HEDGE_SECONDS=3.5

# Server port (Railway sets this automatically)
# PORT=8000
