{
  "manifest_version": 3,
  "name": "VidQuery – AI Study Assistant for YouTube",
  "short_name": "VidQuery",
  "version": "1.0.0",
  "description": "Chat with any YouTube lecture, jump to key moments, search the transcript, build mind maps and take timestamped notes, in English or Hinglish.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open VidQuery (Alt+Shift+Q)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting", "contextMenus"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://newspapers-forecast-recorder-lance.trycloudflare.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Open VidQuery"
    },
    "explain-moment": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Explain what's happening right now in the video"
    }
  },
  "minimum_chrome_version": "116"
}
